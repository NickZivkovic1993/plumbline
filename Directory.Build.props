<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <Version>0.1.0</Version>
    <Authors>Nick Zivkovic</Authors>
    <Copyright>Copyright (c) 2026 Nick Zivkovic</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/NickZivkovic1993/plumbline</RepositoryUrl>
    <PackageProjectUrl>https://github.com/NickZivkovic1993/plumbline</PackageProjectUrl>
    <PackageTags>llm;evals;testing;ai;openai;ollama;regression</PackageTags>
  </PropertyGroup>
</Project>
